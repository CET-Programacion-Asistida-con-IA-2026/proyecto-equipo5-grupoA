+    // Devuelve true si las celdas forman una fila o columna de celdas contiguas
+    function esLineaRecta(celdas) {
+        if (celdas.length < 2) return true;
+
+        const filas = celdas.map(c => Number(c.dataset.fila));
+        const cols = celdas.map(c => Number(c.dataset.col));
+        const mismaFila = filas.every(f => f === filas[0]);
+        const mismaCol = cols.every(c => c === cols[0]);
+
+        if (!mismaFila && !mismaCol) return false;
+
+        // Las posiciones tienen que avanzar de a una, siempre para el mismo lado
+        const posiciones = mismaFila ? cols : filas;
+        const paso = posiciones[1] - posiciones[0];
+        if (paso !== 1 && paso !== -1) return false;
+
+        for (let i = 1; i < posiciones.length; i++) {
+            if (posiciones[i] - posiciones[i - 1] !== paso) return false;
+        }
+        return true;
+    }
